{
  "_description": "本清单固定三协议 HTTP 与 Responses WebSocket 消息级输入观察的基线、补丁和独立契约；不声明后续票据或其他平台已验收。",
  "repository": "https://github.com/router-for-me/CLIProxyAPI",
  "tag": "v8.0.27",
  "commit": "bf9341629ef2300ac9d846a2e80fe2756f63a671",
  "abi_version": 1,
  "schema_version": 6,
  "patches": [
    {
      "path": "patches/0001-readonly-input-audit.patch",
      "sha256": "193c64ce7bbc804bf66f4c4fe142323089aaf161a4dffdb97d1e5eab4f917065"
    }
  ],
  "input_audit": {
    "contract_version": 3,
    "capability": "input_audit_observer",
    "snapshot_capability": "input_audit_snapshot",
    "prepare_method": "input_audit.prepare",
    "prepare_fields": ["id", "object_id", "received_at", "protocol"],
    "snapshot_fields": ["version", "decision", "max_text_bytes", "collector_generation"],
    "prepare_timing": "http-after-final-native-authentication-before-handler-body-read; websocket-at-complete-message-receipt",
    "snapshot_lifetime": "submission-private-bound-to-original-observer-instance",
    "observe_method": "input_audit.observe",
    "capabilities_method": "host.input_audit.capabilities",
    "bridge_diagnostics": "host-lifetime-saturating-failures-fixed-reason-no-input",
    "bridge_capability_fields": ["bridge_failures", "bridge_reason"],
    "catalog_method": "host.input_audit.catalog",
    "protocols": ["chat-completions", "responses", "anthropic-messages", "responses-websocket"],
    "protocol_negotiation": "host-capabilities-must-advertise-all-four-input-protocols",
    "http_routes": ["/v1/messages", "/v1/chat/completions", "/v1/responses", "/v1/responses/compact", "/backend-api/codex/responses", "/backend-api/codex/responses/compact"],
    "responses_websocket": true,
    "websocket_routes": ["/v1/responses", "/backend-api/codex/responses"],
    "websocket_timing": "complete-client-message-before-queue-history-normalization-or-duplex-execution",
    "websocket_identity": "final-native-authentication-bound-opaque-object-no-per-message-reauthentication",
    "websocket_submission_events": ["response.create", "response.append", "response.steer"],
    "max_text_bytes_range": [1, 65536],
    "event_fields": ["id", "object_id", "received_at", "protocol", "snapshot", "body", "read_error"],
    "body_encoding": "base64",
    "read_error_body": "omitted",
    "identity_provider": "config-inline",
    "state_dir_config": "plugins.configs.request-input-audit.state-dir",
    "seed_file": "identity.seed",
    "seed_bytes": 32,
    "directory_mode": "0700",
    "seed_mode": "0600",
    "seed_durability": "file-sync-and-parent-directory-sync",
    "object_id_algorithm": "HMAC-SHA256",
    "object_id_domain": "cpa-request-input-audit/object/v1\u0000",
    "object_id_encoding": "hex",
    "delivery": "synchronous-readonly-isolated-copy-fail-open",
    "native_crash_isolation": false
  },
  "build_validation": {
    "go_version": "go1.27.2",
    "goos": "darwin",
    "goarch": "arm64",
    "target": "./cmd/server",
    "binary": ".build/bin/cliproxyapi",
    "existing_test_packages": [
      "./internal/pluginhost",
      "./sdk/access",
      "./internal/access/config_access",
      "./sdk/pluginapi",
      "./sdk/pluginabi",
      "./sdk/api/handlers",
      "./sdk/api/handlers/claude",
      "./sdk/api/handlers/openai",
      "./internal/api"
    ]
  }
}
