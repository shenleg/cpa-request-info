    "go_version": "go1.27.2",
    "goos": "darwin",
    "goarch": "arm64",
    "target": "./cmd/server",
    "binary": ".build/bin/cliproxyapi",
    "existing_test_packages": [
      "./internal/pluginhost",
      "./sdk/access",
      "./internal/access/config_access",
      "./sdk/pluginapi",
      "./sdk/pluginabi",
      "./sdk/api/handlers",
      "./sdk/api/handlers/openai",
      "./internal/api"
    ]
  }
