index 0000000000000000000000000000000000000000..28cff026502ca5ba881bdab0776f971055ef05fe
--- /dev/null
+++ b/sdk/api/handlers/input_audit.go
@@ -0,0 +1,62 @@
+// This file carries trusted authentication entry timing to the single Chat Completions audit hook.
+package handlers
+
+import (
+	"context"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	log "github.com/sirupsen/logrus"
+)
+
+type inputAuditEntryKey struct{}
+type inputAuditEntry struct {
+	id         string
+	receivedAt time.Time
+	principal  string
+}
+
+type inputAuditHost interface {
+	ObserveInputAudit(context.Context, string, pluginapi.InputAuditEvent)
+}
+
+// WithInputAuditEntry attaches entry UUID/time and the canonical authenticated principal to ctx.
+// Called only after the final built-in inline-key authentication result; returns a derived context.
+// Random-source failure leaves capture disabled without affecting authentication or returning an error.
+func WithInputAuditEntry(ctx context.Context, principal string) context.Context {
+	id, errUUID := uuid.NewRandom()
+	if errUUID != nil {
+		log.Warn("input audit entry unavailable")
+		return ctx
+	}
+	return context.WithValue(ctx, inputAuditEntryKey{}, inputAuditEntry{id: id.String(), receivedAt: time.Now().UTC(), principal: principal})
+}
+
+// ObserveInputAudit delivers body from the existing body reader to the optional read-only host.
+// c carries trusted authentication timing; readError suppresses all body bytes. Returns nothing;
+// absent provenance, delivery errors, and ordinary observer panics never change the HTTP response.
+func (h *BaseAPIHandler) ObserveInputAudit(c *gin.Context, body []byte, readError bool) {
+	if h == nil || c == nil || c.Request == nil {
+		return
+	}
+	entry, ok := c.Request.Context().Value(inputAuditEntryKey{}).(inputAuditEntry)
+	if !ok {
+		return
+	}
+	host, okHost := h.interceptorHost().(inputAuditHost)
+	if !okHost || host == nil {
+		return
+	}
+	defer func() {
+		if recover() != nil {
+			log.Warn("input audit observer panic")
+		}
+	}()
+	event := pluginapi.InputAuditEvent{ID: entry.id, ReceivedAt: entry.receivedAt, Protocol: "chat-completions", ReadError: readError}
+	if !readError {
+		event.Body = body
+	}
+	host.ObserveInputAudit(c.Request.Context(), entry.principal, event)
+}
