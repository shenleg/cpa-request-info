diff --git a/internal/pluginhost/input_audit.go b/internal/pluginhost/input_audit.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef3df7c98b3214ed5d4a7ce249ca6fcf2af6e640
--- /dev/null
+++ b/internal/pluginhost/input_audit.go
@@ -0,0 +1,410 @@
+// This file owns private inline-key identities and isolated, fail-open input-audit observer delivery.
+package pluginhost
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	log "github.com/sirupsen/logrus"
+)
+
+const inputAuditPluginID = "request-input-audit"
+
+// The domain prevents object IDs from sharing a namespace with any other use of the seed.
+const inputAuditIdentityDomain = "cpa-request-input-audit/object/v1\x00"
+const inputAuditSeedSize = 32 // 256 bits of independent random secret for HMAC-SHA256.
+
+// Serialize initial exclusive creation and subsequent reads within this process.
+// Cross-process races fail closed rather than reading a partially written seed.
+var inputAuditIdentityMu sync.Mutex
+
+type inputAuditCapabilities struct {
+	ContractVersion int    `json:"contract_version"`
+	Available       bool   `json:"available"`
+	StateDir        string `json:"state_dir,omitempty"`
+	Reason          string `json:"reason,omitempty"`
+	BridgeFailures  uint64 `json:"bridge_failures"`
+	BridgeReason    string `json:"bridge_reason,omitempty"`
+}
+type inputAuditObject struct {
+	ID string `json:"id"`
+}
+type inputAuditCatalog struct {
+	ContractVersion int                `json:"contract_version"`
+	Available       bool               `json:"available"`
+	Objects         []inputAuditObject `json:"objects"`
+	Reason          string             `json:"reason,omitempty"`
+}
+
+// inputAuditConfig takes only the current inline keys and configured directory; none leave the host.
+func (h *Host) inputAuditConfig() (string, []string, string) {
+	if h == nil {
+		return "", nil, "host_config_unavailable"
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	cfg := h.runtimeConfig
+	if cfg == nil {
+		return "", nil, "host_config_unavailable"
+	}
+	item, ok := cfg.Plugins.Configs[inputAuditPluginID]
+	if !cfg.Plugins.Enabled || !ok || item.Enabled == nil || !*item.Enabled {
+		return "", nil, "audit_config_unavailable"
+	}
+	stateDir := yamlScalarString(yamlMappingValue(&item.Raw, "state-dir"))
+	if stateDir == "" {
+		return "", nil, "state_dir_unavailable"
+	}
+	absolute, errAbsolute := filepath.Abs(stateDir)
+	if errAbsolute != nil {
+		return "", nil, "state_dir_unavailable"
+	}
+	keys := make([]string, 0, len(cfg.APIKeys))
+	seen := make(map[string]struct{}, len(cfg.APIKeys))
+	for _, key := range cfg.APIKeys {
+		key = strings.TrimSpace(key)
+		if key == "" {
+			continue
+		}
+		if _, duplicate := seen[key]; duplicate {
+			continue
+		}
+		seen[key] = struct{}{}
+		keys = append(keys, key)
+	}
+	return absolute, keys, ""
+}
+
+func (h *Host) callHostInputAuditCapabilities() ([]byte, error) {
+	dir, _, reason := h.inputAuditConfig()
+	if reason == "" {
+		_, reason = inputAuditSeed(dir)
+	}
+	response := inputAuditCapabilities{ContractVersion: 2, Available: reason == "", Reason: reason}
+	if h != nil {
+		response.BridgeFailures = h.inputAuditBridgeFailures.Load()
+		if response.BridgeFailures > 0 {
+			response.BridgeReason = "observer_bridge_error"
+		}
+	}
+	if response.Available {
+		response.StateDir = dir
+	}
+	return marshalRPCResult(response)
+}
+
+func (h *Host) callHostInputAuditCatalog() ([]byte, error) {
+	dir, keys, reason := h.inputAuditConfig()
+	var seed []byte
+	if reason == "" {
+		seed, reason = inputAuditSeed(dir)
+	}
+	response := inputAuditCatalog{ContractVersion: 2, Available: reason == "", Reason: reason, Objects: []inputAuditObject{}}
+	if response.Available {
+		for _, key := range keys {
+			response.Objects = append(response.Objects, inputAuditObject{ID: inputAuditObjectID(seed, key)})
+		}
+		sort.Slice(response.Objects, func(i, j int) bool { return response.Objects[i].ID < response.Objects[j].ID })
+	}
+	return marshalRPCResult(response)
+}
+
+func inputAuditObjectID(seed []byte, key string) string {
+	mac := hmac.New(sha256.New, seed)
+	_, _ = mac.Write([]byte(inputAuditIdentityDomain))
+	_, _ = mac.Write([]byte(key))
+	return hex.EncodeToString(mac.Sum(nil))
+}
+
+// inputAuditSeed refuses symlinks, broad permissions, and identity rotation after any persisted state.
+// Root-relative operations keep all seed access anchored even if a path component is replaced.
+func inputAuditSeed(dir string) ([]byte, string) {
+	inputAuditIdentityMu.Lock()
+	defer inputAuditIdentityMu.Unlock()
+	if !filepath.IsAbs(dir) {
+		return nil, "state_dir_unavailable"
+	}
+	// Reject preexisting symlink components before creating anything through the configured path.
+	for path := dir; ; path = filepath.Dir(path) {
+		info, errStat := os.Lstat(path)
+		if errStat == nil {
+			if info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {
+				return nil, "unsafe_state_dir"
+			}
+		} else if !os.IsNotExist(errStat) {
+			return nil, "state_dir_unavailable"
+		}
+		if parent := filepath.Dir(path); parent == path {
+			break
+		}
+	}
+	if errMkdir := os.MkdirAll(dir, 0700); errMkdir != nil {
+		return nil, "state_dir_unavailable"
+	}
+	dirInfo, errStat := os.Lstat(dir)
+	if errStat != nil || !dirInfo.IsDir() || dirInfo.Mode()&os.ModeSymlink != 0 || dirInfo.Mode().Perm() != 0700 {
+		return nil, "unsafe_state_dir"
+	}
+	root, errOpen := os.OpenRoot(dir)
+	if errOpen != nil {
+		return nil, "state_dir_unavailable"
+	}
+	defer func() {
+		if errClose := root.Close(); errClose != nil {
+			log.Warn("input audit identity close failed")
+		}
+	}()
+	anchored, errAnchored := root.Stat(".")
+	if errAnchored != nil || !os.SameFile(dirInfo, anchored) {
+		return nil, "unsafe_state_dir"
+	}
+
+	info, errSeedStat := root.Lstat("identity.seed")
+	if os.IsNotExist(errSeedStat) {
+		entriesDir, errEntriesOpen := root.Open(".")
+		if errEntriesOpen != nil {
+			return nil, "state_dir_unavailable"
+		}
+		entries, errEntries := entriesDir.ReadDir(1)
+		errEntriesClose := entriesDir.Close()
+		if errEntriesClose != nil || (errEntries != nil && errEntries != io.EOF) {
+			return nil, "state_dir_unavailable"
+		}
+		if len(entries) != 0 {
+			return nil, "identity_seed_missing"
+		}
+		seed := make([]byte, inputAuditSeedSize)
+		if _, errRandom := rand.Read(seed); errRandom != nil {
+			return nil, "identity_seed_unavailable"
+		}
+		file, errCreate := root.OpenFile("identity.seed", os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+		if os.IsExist(errCreate) {
+			return readInputAuditSeed(root)
+		}
+		if errCreate != nil {
+			return nil, "identity_seed_unavailable"
+		}
+		written, errWrite := file.Write(seed)
+		errSync := file.Sync()
+		errClose := file.Close()
+		if errWrite != nil || written != len(seed) || errSync != nil || errClose != nil {
+			return nil, "identity_seed_unavailable"
+		}
+		return readInputAuditSeed(root)
+	}
+	if errSeedStat != nil {
+		return nil, "identity_seed_unavailable"
+	}
+	if !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() != inputAuditSeedSize {
+		return nil, "identity_seed_invalid"
+	}
+	return readInputAuditSeed(root)
+}
+
+func readInputAuditSeed(root *os.Root) ([]byte, string) {
+	info, errStat := root.Lstat("identity.seed")
+	if errStat != nil || !info.Mode().IsRegular() || info.Mode().Perm() != 0600 || info.Size() != inputAuditSeedSize {
+		return nil, "identity_seed_invalid"
+	}
+	file, errOpen := root.Open("identity.seed")
+	if errOpen != nil {
+		return nil, "identity_seed_unavailable"
+	}
+	defer func() {
+		if errClose := file.Close(); errClose != nil {
+			log.Warn("input audit identity close failed")
+		}
+	}()
+	openedInfo, errOpenedStat := file.Stat()
+	if errOpenedStat != nil || !os.SameFile(info, openedInfo) || openedInfo.Mode().Perm() != 0600 {
+		return nil, "identity_seed_invalid"
+	}
+	seed, errRead := io.ReadAll(io.LimitReader(file, inputAuditSeedSize+1))
+	if errRead != nil || len(seed) != inputAuditSeedSize {
+		return nil, "identity_seed_invalid"
+	}
+	// File Sync does not make its new directory entry durable. Sync the anchored parent
+	// before accepting the seed, including reopen attempts after a previous sync failure.
+	directory, errOpenDirectory := root.Open(".")
+	if errOpenDirectory != nil {
+		log.Warn("input audit identity directory sync failed")
+		return nil, "identity_seed_sync_unavailable"
+	}
+	errDirectorySync := directory.Sync()
+	errDirectoryClose := directory.Close()
+	if errDirectorySync != nil || errDirectoryClose != nil {
+		log.Warn("input audit identity directory sync failed")
+		return nil, "identity_seed_sync_unavailable"
+	}
+	return seed, ""
+}
+
+// PrepareInputAudit maps final authenticated principal and freezes admission before reading the body.
+// event supplies host-owned submission metadata. Returns request-private delivery state or nil for skip/failure;
+// credentials and body are never sent during preparation. Errors and ordinary panics never affect the model call.
+func (h *Host) PrepareInputAudit(ctx context.Context, principal string, event pluginapi.InputAuditEvent) func(context.Context, []byte, bool) {
+	if h == nil {
+		return nil
+	}
+	var record capabilityRecord
+	for _, current := range h.activeRecords() {
+		if current.id == inputAuditPluginID && current.plugin.Capabilities.InputAuditObserver != nil && !h.isPluginFused(current.id) {
+			record = current
+			break
+		}
+	}
+	observer := record.plugin.Capabilities.InputAuditObserver
+	if observer == nil {
+		return nil
+	}
+	h.mu.Lock()
+	instance := h.loaded[record.id]
+	if instance != nil {
+		observer = instance.plugin.Capabilities.InputAuditObserver
+	}
+	h.mu.Unlock()
+	if instance == nil || observer == nil || !h.inputAuditInstanceCurrent(record, instance) {
+		h.recordInputAuditBridgeFailure()
+		return nil
+	}
+	dir, keys, reason := h.inputAuditConfig()
+	if reason != "" {
+		log.Warn("input audit identity unavailable")
+		return nil
+	}
+	matched := false
+	for _, key := range keys {
+		if key == principal {
+			matched = true
+			break
+		}
+	}
+	if !matched {
+		log.Warn("input audit identity mapping unavailable")
+		return nil
+	}
+	seed, seedReason := inputAuditSeed(dir)
+	if seedReason != "" {
+		log.Warn("input audit identity unavailable")
+		return nil
+	}
+	event.ObjectID = inputAuditObjectID(seed, principal)
+	event.Body = nil
+	event.ReadError = false
+	decision, errPrepare := prepareInputAudit(inputAuditContext(ctx), observer, event)
+	if errPrepare != nil || !validInputAuditSnapshot(decision) {
+		h.recordInputAuditBridgeFailure()
+		log.Warn("input audit preparation unavailable")
+		return nil
+	}
+	if decision.Decision == "skip" {
+		return nil
+	}
+	if decision.Decision != "capture" {
+		h.recordInputAuditBridgeFailure()
+		log.Warn("input audit preparation unavailable")
+		return nil
+	}
+	event.Snapshot = decision
+	// The closure retains only opaque identity, fixed metadata, and the original observer instance.
+	// Rechecking current keys or admission here would retroactively change a slow submission's decision.
+	return func(deliveryContext context.Context, body []byte, readError bool) {
+		if !h.inputAuditInstanceCurrent(record, instance) {
+			h.recordInputAuditBridgeFailure()
+			log.Warn("input audit observer instance unavailable")
+			return
+		}
+		copyEvent := event
+		copyEvent.ReadError = readError
+		if !readError {
+			copyEvent.Body = bytes.Clone(body)
+		}
+		h.observeInputAudit(inputAuditContext(deliveryContext), observer, copyEvent)
+	}
+}
+
+func (h *Host) inputAuditInstanceCurrent(record capabilityRecord, instance *loadedPlugin) bool {
+	if h == nil || instance == nil || !h.recordCurrent(record) || h.isPluginFused(record.id) {
+		return false
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	// Path/version alone does not distinguish unloading and reopening the exact same plugin binary.
+	return h.loaded[record.id] == instance
+}
+
+func inputAuditContext(ctx context.Context) context.Context {
+	if ctx == nil {
+		return context.Background()
+	}
+	// Submission auditing does not depend on whether the client remains connected after sending its body.
+	return context.WithoutCancel(ctx)
+}
+
+func validInputAuditSnapshot(snapshot pluginapi.InputAuditSnapshot) bool {
+	if snapshot.Version != 2 {
+		return false
+	}
+	switch snapshot.Decision {
+	case "capture":
+		// Contract v2 fixes the audit-copy ceiling at 64 KiB; generation binds the original collector lifetime.
+		generation, errGeneration := hex.DecodeString(snapshot.CollectorGeneration)
+		return snapshot.MaxTextBytes == 64<<10 && errGeneration == nil && len(generation) == 16
+	case "skip", "unavailable":
+		if snapshot.CollectorGeneration == "" {
+			return snapshot.MaxTextBytes == 0
+		}
+		generation, errGeneration := hex.DecodeString(snapshot.CollectorGeneration)
+		return snapshot.MaxTextBytes == 0 && errGeneration == nil && len(generation) == 16
+	default:
+		return false
+	}
+}
+
+func prepareInputAudit(ctx context.Context, observer pluginapi.InputAuditObserver, event pluginapi.InputAuditEvent) (snapshot pluginapi.InputAuditSnapshot, err error) {
+	defer func() {
+		if recover() != nil {
+			err = errors.New("input_audit_prepare_failed")
+		}
+	}()
+	return observer.PrepareInputAudit(ctx, event)
+}
+
+func (h *Host) observeInputAudit(ctx context.Context, observer pluginapi.InputAuditObserver, event pluginapi.InputAuditEvent) {
+	defer func() {
+		if recover() != nil {
+			h.recordInputAuditBridgeFailure()
+			log.Warn("input audit observer panic")
+		}
+	}()
+	if errObserve := observer.ObserveInputAudit(ctx, event); errObserve != nil {
+		h.recordInputAuditBridgeFailure()
+		log.Warn("input audit observer failed")
+	}
+}
+
+func (h *Host) recordInputAuditBridgeFailure() {
+	if h == nil {
+		return
+	}
+	// Admission/transport failures precede collector diagnostics; aggregate a bounded host-lifetime count.
+	// Saturation preserves historical evidence instead of wrapping to zero under sustained failures.
+	for {
+		current := h.inputAuditBridgeFailures.Load()
+		if current == ^uint64(0) || h.inputAuditBridgeFailures.CompareAndSwap(current, current+1) {
+			return
+		}
+	}
+}
