new file mode 100644
index 0000000000000000000000000000000000000000..556002ae6eff1085ccba4fdf326f2b6ecfafcfb2
--- /dev/null
+++ b/sdk/pluginapi/input_audit.go
@@ -0,0 +1,60 @@
+// This file defines the independent v2 read-only input-audit contract without changing ABI or schema versions.
+package pluginapi
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+)
+
+// InputAuditSnapshot is a bounded admission decision captured before reading the submitted body.
+// Missing versions or unknown decisions are failures, never implicit permission to capture.
+type InputAuditSnapshot struct {
+	Version             int    `json:"version"`
+	Decision            string `json:"decision"`
+	MaxTextBytes        int    `json:"max_text_bytes"`
+	CollectorGeneration string `json:"collector_generation"`
+}
+
+// InputAuditEvent carries only trusted submission identity, a frozen decision, and the original protocol bytes.
+// PrepareInputAudit receives no body; read failures omit partial bytes from ObserveInputAudit.
+type InputAuditEvent struct {
+	ID         string             `json:"id"`
+	ObjectID   string             `json:"object_id"`
+	ReceivedAt time.Time          `json:"received_at"`
+	Protocol   string             `json:"protocol"`
+	Snapshot   InputAuditSnapshot `json:"snapshot"`
+	Body       []byte             `json:"body"`
+	ReadError  bool               `json:"read_error,omitempty"`
+}
+
+// MarshalJSON encodes event bytes as base64, omitting Body on read failure while preserving the frozen snapshot.
+// Successful empty inputs remain an empty base64 string. Returns JSON or an encoding error.
+func (event InputAuditEvent) MarshalJSON() ([]byte, error) {
+	type wireEvent struct {
+		ID         string             `json:"id"`
+		ObjectID   string             `json:"object_id"`
+		ReceivedAt time.Time          `json:"received_at"`
+		Protocol   string             `json:"protocol"`
+		Snapshot   InputAuditSnapshot `json:"snapshot"`
+		Body       *[]byte            `json:"body,omitempty"`
+		ReadError  bool               `json:"read_error,omitempty"`
+	}
+	wire := wireEvent{ID: event.ID, ObjectID: event.ObjectID, ReceivedAt: event.ReceivedAt, Protocol: event.Protocol, Snapshot: event.Snapshot, ReadError: event.ReadError}
+	if !event.ReadError {
+		body := event.Body
+		if body == nil {
+			body = []byte{}
+		}
+		wire.Body = &body
+	}
+	return json.Marshal(wire)
+}
+
+// InputAuditObserver prepares a bounded v2 decision and receives an isolated authenticated submission.
+// PrepareInputAudit reads only admission configuration; ObserveInputAudit cannot change execution.
+// Delivery errors and ordinary panics fail open; native process faults are outside this guarantee.
+type InputAuditObserver interface {
+	PrepareInputAudit(context.Context, InputAuditEvent) (InputAuditSnapshot, error)
+	ObserveInputAudit(context.Context, InputAuditEvent) error
+}
