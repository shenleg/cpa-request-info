@@ -0,0 +1,70 @@
+// This file binds authenticated admission decisions to the later Chat Completions body observation.
+package handlers
+
+import (
+	"context"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/pluginapi"
+	log "github.com/sirupsen/logrus"
+)
+
+type inputAuditEntryKey struct{}
+
+// InputAuditHost prepares a request-private delivery function from final built-in authentication.
+// The function binds the original observer and admission decision without retaining credentials.
+type InputAuditHost interface {
+	PrepareInputAudit(context.Context, string, pluginapi.InputAuditEvent) func(context.Context, []byte, bool)
+}
+
+// WithInputAuditEntry synchronously freezes admission before the handler can read the submitted body.
+// principal is the final built-in authentication result, host owns trusted identity mapping, and ctx is derived.
+// Returns a context carrying only private delivery state; absent hosts, errors, or panics fail open.
+func WithInputAuditEntry(ctx context.Context, principal string, host InputAuditHost) context.Context {
+	if host == nil {
+		return ctx
+	}
+	id, errUUID := uuid.NewRandom()
+	if errUUID != nil {
+		log.Warn("input audit entry unavailable")
+		return ctx
+	}
+	delivery := prepareInputAuditEntry(ctx, host, principal, pluginapi.InputAuditEvent{ID: id.String(), ReceivedAt: time.Now().UTC(), Protocol: "chat-completions"})
+	if delivery == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, inputAuditEntryKey{}, delivery)
+}
+
+func prepareInputAuditEntry(ctx context.Context, host InputAuditHost, principal string, event pluginapi.InputAuditEvent) (delivery func(context.Context, []byte, bool)) {
+	defer func() {
+		if recover() != nil {
+			log.Warn("input audit preparation panic")
+		}
+	}()
+	return host.PrepareInputAudit(ctx, principal, event)
+}
+
+// ObserveInputAudit passes the body to the delivery state prepared at authenticated entry.
+// c supplies the request context; readError omits partial bytes. Returns nothing and never changes the response.
+// Missing decisions or ordinary observer panics fail open rather than sampling current configuration.
+func (h *BaseAPIHandler) ObserveInputAudit(c *gin.Context, body []byte, readError bool) {
+	if h == nil || c == nil || c.Request == nil {
+		return
+	}
+	delivery, ok := c.Request.Context().Value(inputAuditEntryKey{}).(func(context.Context, []byte, bool))
+	if !ok || delivery == nil {
+		return
+	}
+	defer func() {
+		if recover() != nil {
+			log.Warn("input audit observer panic")
+		}
+	}()
+	if readError {
+		body = nil
+	}
+	delivery(c.Request.Context(), body, readError)
+}
