+// This file defines the independent, read-only input-audit contract without changing ABI or schema versions.
+package pluginapi
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+)
+
+// InputAuditEvent is the authenticated entry snapshot, excluding credentials and request metadata.
+// Body contains the original bytes; read failures must not include partial bytes.
+type InputAuditEvent struct {
+	ID         string    `json:"id"`
+	ObjectID   string    `json:"object_id"`
+	ReceivedAt time.Time `json:"received_at"`
+	Protocol   string    `json:"protocol"`
+	Body       []byte    `json:"body"`
+	ReadError  bool      `json:"read_error,omitempty"`
+}
+
+// MarshalJSON encodes event bytes as base64, omitting Body on read failure.
+// Successful empty inputs remain an empty base64 string. Returns JSON or an encoding error.
+func (event InputAuditEvent) MarshalJSON() ([]byte, error) {
+	type wireEvent struct {
+		ID         string    `json:"id"`
+		ObjectID   string    `json:"object_id"`
+		ReceivedAt time.Time `json:"received_at"`
+		Protocol   string    `json:"protocol"`
+		Body       *[]byte   `json:"body,omitempty"`
+		ReadError  bool      `json:"read_error,omitempty"`
+	}
+	wire := wireEvent{ID: event.ID, ObjectID: event.ObjectID, ReceivedAt: event.ReceivedAt, Protocol: event.Protocol, ReadError: event.ReadError}
+	if !event.ReadError {
+		body := event.Body
+		if body == nil {
+			body = []byte{}
+		}
+		wire.Body = &body
+	}
+	return json.Marshal(wire)
+}
+
+// InputAuditObserver receives a private copy of the raw authenticated Chat Completions entry.
+// ObserveInputAudit treats event as read-only, returns delivery errors, and cannot influence execution.
+// Ordinary panics and errors are fail-open; native process faults cannot be recovered by this contract.
+type InputAuditObserver interface {
+	ObserveInputAudit(context.Context, InputAuditEvent) error
+}
